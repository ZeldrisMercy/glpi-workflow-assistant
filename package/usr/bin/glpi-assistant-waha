#!/usr/bin/env bash
# Reconfigure the owned local service; preserve session volume and rollback container.
set -Eeuo pipefail
umask 077
[[ ${EUID} -eq 0 ]] || { echo 'Execute com sudo: sudo glpi-assistant-waha [devlikeapro/waha@sha256:DIGEST]'; exit 1; }
command -v docker >/dev/null
command -v python3 >/dev/null
docker info >/dev/null
name=glpi-assistant-waha
previous=glpi-assistant-waha-previous
# Official stable 2026.9.1, Docker Hub index verified 2026-09-22.
image_ref=${1:-devlikeapro/waha@sha256:41283bd89922ec3f722e5a772b844c451634d4aa72e9c34043c3480184f970fe}
exec 9>/run/lock/glpi-assistant-waha.lock
flock -n 9 || { echo 'Outra instalação do WAHA está em andamento.'; exit 1; }
had_old=false
was_running=false
if docker container inspect "$previous" >/dev/null 2>&1; then
  [[ $(docker inspect --format '{{index .Config.Labels "glpi-assistant.component"}}' "$previous") == waha ]] || { echo 'Rollback não gerenciado; operação cancelada.'; exit 1; }
  [[ $(docker inspect --format '{{.State.Running}}' "$previous") == false ]] || { echo 'Rollback em execução; operação cancelada para preservar a sessão.'; exit 1; }
fi
if docker container inspect "$name" >/dev/null 2>&1; then
  [[ $(docker inspect --format '{{index .Config.Labels "glpi-assistant.component"}}' "$name") == waha ]] || { echo 'Container não gerenciado; nenhuma alteração realizada.'; exit 1; }
  had_old=true
  was_running=$(docker inspect --format '{{.State.Running}}' "$name")
fi
if [[ $image_ref =~ ^devlikeapro/waha@sha256:[a-f0-9]{64}$ ]]; then
  docker pull "$image_ref"
else
  echo 'Informe uma imagem oficial revisada por digest: devlikeapro/waha@sha256:DIGEST'
  echo 'A tag latest não é aceita. Fixar digest não substitui verificar vulnerabilidades.'
  exit 1
fi
install -d -m 700 /var/lib/glpi-assistant/data /var/lib/glpi-assistant/waha
python3 - <<'PY'
import hashlib,json,os,secrets,tempfile
from pathlib import Path
root=Path('/var/lib/glpi-assistant')
p=root/'data/waha.json'
key=json.loads(p.read_text())['api_key'] if p.exists() else secrets.token_hex(32)
if not isinstance(key,str) or len(key)<32 or '\n' in key:raise SystemExit('Chave existente inválida. Revise a configuração local.')
def write_private(path,text):
    fd,tmp=tempfile.mkstemp(dir=path.parent)
    with os.fdopen(fd,'w') as out:
        out.write(text);out.flush();os.fsync(out.fileno())
    os.replace(tmp,path)
write_private(p,json.dumps({'api_key':key}))
settings=['WAHA_API_KEY=sha512:'+hashlib.sha512(key.encode()).hexdigest(),
 'WAHA_DASHBOARD_ENABLED=false','WHATSAPP_SWAGGER_ENABLED=false',
 'WAHA_DASHBOARD_USERNAME=admin','WAHA_DASHBOARD_PASSWORD='+secrets.token_hex(32),
 'WHATSAPP_SWAGGER_USERNAME=admin','WHATSAPP_SWAGGER_PASSWORD='+secrets.token_hex(32),
 'WHATSAPP_DEFAULT_ENGINE=WEBJS','WAHA_LOG_LEVEL=error','WAHA_PRINT_QR=false',
 'WAHA_EVENTS_DOWNLOAD_MEDIA=false','WAHA_API_DOWNLOAD_MEDIA=false','WHATSAPP_DOWNLOAD_MEDIA=false',
 'WHATSAPP_FILES_FOLDER=/tmp/whatsapp-files','WAHA_WORKER_RESTART_SESSIONS=true']
write_private(root/'waha/server.env','\n'.join(settings)+'\n')
PY
renamed_old=false
rollback() {
  echo 'Configuração nova não passou na verificação; restaurando o container anterior.' >&2
  trap - ERR
  if [[ $renamed_old == true || $had_old == false ]]; then
    docker rm -f "$name" >/dev/null 2>&1 || true
  fi
  if [[ $renamed_old == true ]]; then docker rename "$previous" "$name"; fi
  if [[ $had_old == true && $was_running == true ]]; then docker start "$name" >/dev/null; fi
}
trap rollback ERR
if [[ $had_old == true ]]; then
  # Keep only the immediate predecessor; never remove an unknown or running container.
  if docker container inspect "$previous" >/dev/null 2>&1; then docker rm "$previous" >/dev/null; fi
  docker stop -t 20 "$name" >/dev/null
  docker rename "$name" "$previous"
  renamed_old=true
fi
# No docker socket or Assistant data/config mount is exposed to WAHA.
docker run -d --name "$name" --restart unless-stopped \
  --label glpi-assistant.component=waha --label glpi-assistant.security=local-auth-v2 \
  --pull never --init --cap-drop ALL --security-opt no-new-privileges \
  --pids-limit 512 --memory 2g --memory-swap 2g --cpus 2 \
  -p 127.0.0.1:3000:3000 \
  --env-file /var/lib/glpi-assistant/waha/server.env \
  -v glpi-assistant-waha-sessions:/app/.sessions \
  --log-opt max-size=10m --log-opt max-file=2 \
  "$image_ref" >/dev/null
python3 - <<'PY'
import json,time,urllib.request,urllib.error
from pathlib import Path
key=json.loads(Path('/var/lib/glpi-assistant/data/waha.json').read_text())['api_key']
url='http://127.0.0.1:3000/api/sessions?all=true'
opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))
for attempt in range(60):
    try:
        try:
            opener.open(url,timeout=2)
            raise SystemExit('API sem autenticação: rollback obrigatório.')
        except urllib.error.HTTPError as exc:
            if exc.code not in (401,403):raise
        with opener.open(urllib.request.Request(url,headers={'X-Api-Key':key}),timeout=2) as response:
            if response.status==200:break
    except (OSError,urllib.error.URLError):
        if attempt==59:raise SystemExit('WAHA indisponível ou chave recusada.')
        time.sleep(1)
PY
trap - ERR
printf '%s\n' "$image_ref" > /var/lib/glpi-assistant/waha/image-id.txt
echo 'WAHA restrito a localhost; API autenticada, painéis e download de mídia desativados.'
echo 'A conta não foi vinculada nem o envio automático ativado por este instalador.'
if [[ $had_old == true ]]; then echo "Rollback preservado: $previous (volume de sessão compartilhado; não execute os dois juntos)."; fi
